                "mandatory": true,
                "unique": false,
                "multiple": false,
                "non_localizable": false
              },
              {
                "display_name": "Loading Strategy",
                "uid": "strategy",
                "data_type": "text",
                "display_type": "dropdown",
                "enum": {
                  "advanced": false,
                  "choices": [
                    { "value": "afterInteractive" },
                    { "value": "lazyOnload" },
                    { "value": "beforeInteractive" }
                  ]
                },
                "field_metadata": {
                  "default_value": "afterInteractive",
                  "description": "afterInteractive suits analytics. Use beforeInteractive only when required."
