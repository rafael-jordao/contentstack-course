# Copy to .env.local and fill in. The delivery client validates its
# configuration at module load, so a missing value throws on the first request.

# Settings > Tokens > Stack API Key
CONTENTSTACK_API_KEY=blt00000000000000

# Settings > Tokens > Delivery Tokens
CONTENTSTACK_DELIVERY_TOKEN=cs0000000000000000000000

# Must match an environment name in Settings > Environments
CONTENTSTACK_ENVIRONMENT=development

# NA | EU | AU | AZURE_NA | AZURE_EU | GCP_NA | GCP_EU
# Required on purpose: the SDK defaults to the US data center, so an unset
# region silently points a non-US stack at the wrong host.
CONTENTSTACK_REGION=EU

# Shared with the Contentstack webhook that calls POST /api/revalidate.
# Any random string; the route compares it with a timing-safe digest.
CONTENTSTACK_WEBHOOK_SECRET=

# Optional. Found next to the delivery token, under the Preview Token tab.
# Without it Live Preview and the Visual Builder render nothing and the site
# still works.
CONTENTSTACK_PREVIEW_TOKEN=

# Optional. Absolute origin for robots.txt, sitemap.xml, llms.txt, the AI
# catalog and metadataBase. Falls back to VERCEL_PROJECT_PRODUCTION_URL and
# then to http://localhost:3000. Read at build time: setting it only at
# runtime leaves localhost urls baked into the prerendered output.
SITE_URL=

# Only needed by `pnpm content-model:import`. Settings > Tokens > Management
# Tokens, with write access. Not used by the app at runtime.
CONTENTSTACK_MANAGEMENT_TOKEN=
